{
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"]
    }
  },
  "lsp": {
    "nixd": {
      "settings": {
        "nixpkgs": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.wsl.pkgs"
        },
        "options": {
          "flake-parts": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).debug.options"
          },
          "nixos": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.wsl.options"
          },
          "home-manager": {
            "expr": "(builtins.getFlake (builtins.toString ./.)).homeConfigurations.\"constantan@wsl-x86_64\".options"
          }
        }
      }
    }
  }
}
